# ── Base de datos ────────────────────────────────────────────────
# Local: docker-compose / podman. Producción: cadena *pooled* de Neon.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ambarnayrubis

# Cadena aleatoria larga (openssl rand -hex 32). Firma sesiones y enlaces de galerías.
PAYLOAD_SECRET=

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Cloudflare R2 ────────────────────────────────────────────────
# Si se dejan vacías, las fotos se guardan en ./uploads (solo para desarrollo).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket con acceso público (portafolio)
R2_PUBLIC_BUCKET=
# URL pública del bucket: dominio propio (https://fotos.tudominio.com) o https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
# Bucket privado (galerías de clientes), SIN acceso público
R2_PRIVATE_BUCKET=

# ── Email (Resend) ───────────────────────────────────────────────
# Opcional. Sin API key los emails se imprimen en consola.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=web@tudominio.com
EMAIL_FROM_NAME=Ambar Nayrubis
# Destino de las consultas si no se configura un email en "Ajustes del sitio"
CONTACT_EMAIL=
